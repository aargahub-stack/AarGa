nk-0 h-8 w-8\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Faarga-logo.png&amp;w=128&amp;q=75 1x, /_next/image?url=%2Faarga-logo.png&amp;w=256&amp;q=75 2x\" src=\"/_next/image?url=%2Faarga-logo.png&amp;w=256&amp;q=75\"/><span class=\"text-lg font-extrabold tracking-tight text-ink\">Aar<span class=\"text-emerald-600\">Ga</span></span></a><nav class=\"hidden items-center gap-1 md:flex\"><a class=\"rounded-full px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-emerald-50 hover:text-emerald-700\" href=\"/\">Home</a><a class=\"rounded-full px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-emerald-50 hover:text-emerald-700\" href=\"/ecosystem\">Ecosystem</a><a class=\"rounded-full px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-emerald-50 hover:text-emerald-700\" href=\"/tech\">Tech Hub</a><a class=\"rounded-full px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-emerald-50 hover:text-emerald-700\" href=\"/interns\">Verified Interns</a></nav><div class=\"hidden md:block\"><a class=\"inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-white shadow-glass transition-transform hover:scale-[1.03] hover:bg-moss-800\" href=\"/admin\">Founder Sign In<span aria-hidden=\"true\">↗</span></a></div><button aria-label=\"Toggle menu\" aria-expanded=\"false\" class=\"flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 md:hidden\"><span class=\"sr-only\">Menu</span><div class=\"space-y-1.5\"><span class=\"block h-0.5 w-5 bg-ink transition-transform \"></span><span class=\"block h-0.5 w-5 bg-ink transition-opacity \"></span><span class=\"block h-0.5 w-5 bg-ink transition-transform \"></span></div></button></div></header><div class=\"min-h-screen\"><div class=\"mx-auto max-w-7xl px-6 pt-28 pb-20 lg:px-8\"><header class=\"max-w-3xl\"><span class=\"text-xs font-bold uppercase tracking-widest text-emerald-600\">Verified Interns Registry</span><h1 class=\"mt-3 text-4xl font-black tracking-tight text-ink sm:text-5xl text-balance\">Skills verified by telemetry, not resumes.</h1><p class=\"mt-4 text-lg leading-relaxed text-slate-600\">Every candidate below is scored by the VeriSkill engine against real, shipped project contributions across the AarGa ecosystem.</p></header><div class=\"mt-10 grid grid-cols-1 gap-5 sm:grid-cols-3 sm:max-w-xl\"><div class=\"rounded-2xl border border-slate-200 bg-white/70 p-5 shadow-glass\"><div class=\"font-mono text-2xl font-black text-ink\">2</div><div class=\"mt-1 text-xs font-semibold text-slate-500\">Total interns</div></div><div class=\"rounded-2xl border border-slate-200 bg-white/70 p-5 shadow-glass\"><div class=\"font-mono text-2xl font-black text-emerald-600\">2</div><div class=\"mt-1 text-xs font-semibold text-slate-500\">Fully verified</div></div><div class=\"rounded-2xl border border-slate-200 bg-white/70 p-5 shadow-glass\"><div class=\"font-mono text-2xl font-black text-moss-600\">93</div><div class=\"mt-1 text-xs font-semibold text-slate-500\">Avg. telemetry score</div></div></div><section class=\"mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3\"><div class=\"group flex flex-col rounded-3xl border border-slate-200 bg-white/70 p-6 shadow-glass transition-shadow hover:shadow-glass-lg\"><div class=\"flex items-start justify-between\"><div class=\"flex items-center gap-3\"><div class=\"flex h-12 w-12 items-center justify-center rounded-2xl bg-ink text-sm font-bold text-white\">FS</div><div><h3 class=\"text-base font-bold text-ink\">Fatima Sheikh</h3><p class=\"text-xs font-medium text-slate-500\">Data &amp; Analytics Intern</p></div></div><span class=\"shrink-0 rounded-full px-2.5 py-1 text-[11px] font-bold bg-emerald-100 text-emerald-800\">Verified</span></div><p class=\"mt-4 text-sm leading-relaxed text-slate-600\">Designed the funder-facing impact report templates now used across 40+ NGO partners.</p><div class=\"mt-5 flex items-center justify-between rounded-2xl bg-slate-50 px-4 py-3 font-mono\"><div><div class=\"text-[10px] uppercase tracking-wide text-slate-400\">Telemetry Score</div><div class=\"text-2xl font-black text-emerald-600\">95</div></div><div class=\"text-right\"><div class=\"text-[10px] uppercase tracking-wide text-slate-400\">Projects Shipped</div><div class=\"text-2xl font-black text-ink\">3</div></div></div><div class=\"mt-5 flex flex-wrap gap-2\"><span class=\"rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-600\">dbt</span><span class=\"rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-600\">ClickHouse</span><span class=\"rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-600\">Data Modeling</span><span class=\"rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-600\">Impact Reporting</span></div><div class=\"mt-5 flex items-center justify-between border-t border-slate-100 pt-4 text-xs text-slate-400\"><span>Cohort 8 — Exora Insight</span><span>Hyderabad, IN</span></div></div><div class=\"group flex flex-col rounded-3xl border border-slate-200 bg-white/70 p-6 shadow-glass transition-shadow hover:shadow-glass-lg\"><div class=\"flex items-start justify-between\"><div class=\"flex items-center gap-3\"><div class=\"flex h-12 w-12 items-center justify-center rounded-2xl bg-ink text-sm font-bold text-white\">MN</div><div><h3 class=\"text-base font-bold text-ink\">Meera Nair</h3><p class=\"text-xs font-medium text-slate-500\">Trust &amp; Safety Intern</p></div></div><span class=\"shrink-0 rounded-full px-2.5 py-1 text-[11px] font-bold bg-emerald-100 text-emerald-800\">Verified</span></div><p class=\"mt-4 text-sm leading-relaxed text-slate-600\">Co-authored the scoring rubric that now powers the VeriSkill credentialing engine.</p><div class=\"mt-5 flex items-center justify-between rounded-2xl bg-slate-50 px-4 py-3 font-mono\"><div><div class=\"text-[10px] uppercase tracking-wide text-slate-400\">Telemetry Score</div><div class=\"text-2xl font-black text-emerald-600\">90</div></div><div class=\"text-right\"><div class=\"text-[10px] uppercase tracking-wide text-slate-400\">Projects Shipped</div><div class=\"text-2xl font-black text-ink\">5</div></div></div><div class=\"mt-5 flex flex-wrap gap-2\"><span class=\"rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-600\">Eval Harness Design</span><span class=\"rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-600\">Python</span><span class=\"rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-600\">Fraud Heuristics</span></div><div class=\"mt-5 flex items-center justify-between border-t border-slate-100 pt-4 text-xs text-slate-400\"><span>Cohort 9 — VeriSkill Core</span><span>Kochi, IN</span></div></div></section></div><!--$--><!--/$--></div><footer class=\"border-t border-slate-200 bg-white/60\"><div class=\"mx-auto max-w-7xl px-6 py-14 lg:px-8\"><div class=\"grid gap-10 md:grid-cols-2 lg:grid-cols-5\"><div class=\"lg:col-span-2\"><div class=\"flex items-center gap-2.5\"><img alt=\"AarGa Logo\" width=\"120\" height=\"120\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain shrink-0 h-8 w-8\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Faarga-logo.png&amp;w=128&amp;q=75 1x, /_next/image?url=%2Faarga-logo.png&amp;w=256&amp;q=75 2x\" src=\"/_next/image?url=%2Faarga-logo.png&amp;w=256&amp;q=75\"/><span class=\"text-lg font-extrabold tracking-tight\">Aar<span class=\"text-emerald-600\">Ga</span></span></div><p class=\"mt-4 max-w-sm text-sm leading-relaxed text-slate-600\">One ecosystem, two missions: a grassroots NGO built to serve communities first, and a SaaS platform engineered to sustain that mission at scale.</p></div><div><h4 class=\"text-sm font-bold uppercase tracking-wide