{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/tech/layout,_N_T_/tech/page,_N_T_/tech"},"segmentPaths":["/_tree","/_full","/tech/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"urbanist_f470c22e-module__cPLwLa__variable jetbrains_mono_7d1d8308-module__N6DFtq__variable\" data-scroll-behavior=\"smooth\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/051742360c26797e-s.p.1bkzbscqrt8rl.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/5c8bbc89ca099f34-s.p.2qijkc4_gtkq0.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Faarga-logo.png&amp;w=128&amp;q=75 1x, /_next/image?url=%2Faarga-logo.png&amp;w=256&amp;q=75 2x\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/1pp01t92794go.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/3yfl9fgvivx3-.js\"/><script src=\"/_next/static/chunks/1j-k-ieesrs8m.js\" async=\"\"></script><script src=\"/_next/static/chunks/25t-tqdrx6u_8.js\" async=\"\"></script><script src=\"/_next/static/chunks/1mkbuudhndal5.js\" async=\"\"></script><script src=\"/_next/static/chunks/11jq0c2_zavac.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0w27se9clqdmb.js\" async=\"\"></script><script src=\"/_next/static/chunks/3fntmmi971322.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/04z364tqscwdn.js\" async=\"\" crossorigin=\"\"></script><title>Tech Hub — AarGa</title><meta name=\"description\" content=\"Detailed capabilities and engineering lifecycle behind the AarGa ecosystem: NexFix, Exora, and AarVed.\"/><meta property=\"og:title\" content=\"AarGa — One Ecosystem. Two Missions.\"/><meta property=\"og:description\" content=\"AarGa unifies social impact with enterprise engineering.\"/><meta property=\"og:url\" content=\"https://aarga.org\"/><meta property=\"og:site_name\" content=\"AarGa\"/><meta property=\"og:image\" content=\"https://aarga.org/aarga-logo.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"AarGa Ecosystem Logo\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"AarGa — One Ecosystem. Two Missions.\"/><meta name=\"twitter:description\" content=\"AarGa unifies social impact with enterprise engineering.\"/><meta name=\"twitter:image\" content=\"https://aarga.org/aarga-logo.png\"/><meta name=\"twitter:image:alt\" content=\"AarGa Ecosystem Logo\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"shortcut icon\" href=\"/aarga-logo.png\"/><link rel=\"icon\" href=\"/aarga-logo.png\"/><link rel=\"apple-touch-icon\" href=\"/aarga-logo.png\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"font-sans bg-paper text-ink antialiased selection:bg-emerald-200\"><div hidden=\"\"><!--$--><!--/$--></div><!--$!--><template data-dgst=\"BAILOUT_TO_CLIENT_SIDE_RENDERING\"></template><!--/$--><header class=\"sticky top-0 z-50 transition-all duration-300 -mb-[72px] bg-transparent border-b border-transparent shadow-none\"><div class=\"mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8\"><a class=\"flex items-center gap-2.5 group\" href=\"/\"><img alt=\"AarGa Logo\" width=\"120\" height=\"120\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain shrink-0 h-8 w-8\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Faarga-logo.png&amp;w=128&amp;q=75 1x, /_next/image?url=%2Faarga-logo.png&amp;w=256&amp;q=75 2x\" src=\"/_next/image?url=%2Faarga-logo.png&amp;w=256&amp;q=75\"/><span class=\"text-lg font-extrabold tracking-tight text-ink\">Aar<span class=\"text-emerald-600\">Ga</span></span></a><nav class=\"hidden items-center gap-1 md:flex\"><a class=\"rounded-full px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-emerald-50 hover:text-emerald-700\" href=\"/\">Home</a><a class=\"rounded-full px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-emerald-50 hover:text-emerald-700\" href=\"/ecosystem\">Ecosystem</a><a class=\"rounded-full px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-emerald-50 hover:text-emerald-700\" href=\"/tech\">Tech Hub</a><a class=\"rounded-full px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-emerald-50 hover:text-emerald-700\" href=\"/interns\">Verified Interns</a></nav><div class=\"hidden md:block\"><a class=\"inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-white shadow-glass transition-transform hover:scale-[1.03] hover:bg-moss-800\" href=\"/admin\">Founder Sign In<span aria-hidden=\"true\">↗</span></a></div><button aria-label=\"Toggle menu\" aria-expanded=\"false\" class=\"flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 md:hidden\"><span class=\"sr-only\">Menu</span><div class=\"space-y-1.5\"><span class=\"block h-0.5 w-5 bg-ink transition-transform \"></span><span class=\"block h-0.5 w-5 bg-ink transition-opacity \"></span><span class=\"block h-0.5 w-5 bg-ink transition-transform \"></span></div></button></div></header><div class=\"min-h-screen\"><div class=\"mx-auto max-w-7xl px-6 pt-28 pb-20 lg:px-8\"><header class=\"max-w-3xl\"><span class=\"text-xs font-bold uppercase tracking-widest text-emerald-600\">Tech Hub</span><h1 class=\"mt-3 text-4xl font-black tracking-tight text-ink sm:text-5xl text-balance\">Every product, one engineering spine.</h1><p class=\"mt-4 text-lg text-slate-600 leading-relaxed\">Three live products<!-- -->, <!-- -->three real deployments<!-- -->, one shared platform core. Below is the full capability breakdown and the lifecycle every feature moves through before it reaches an NGO partner site or an enterprise customer.</p></header><section class=\"mt-16 grid grid-cols-1 gap-5 sm:grid-cols-2\"><div class=\"rounded-2xl border border-slate-200 bg-white/70 p-6 shadow-glass\"><h3 class=\"text-lg font-bold text-ink\">Unified Identity Core</h3><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Single sign-on and role-based access spanning every ecosystem tool, from field technician accounts in NexFix to founder-level access in the Portal.</p></div><div class=\"rounded-2xl border border-slate-200 bg-white/70 p-6 shadow-glass\"><h3 class=\"text-lg font-bold text-ink\">Composable Ledger Service</h3><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">A shared double-entry ledger underlies NexFix field operations and enterprise accounting, giving every transaction a consistent, auditable trail.</p></div><div class=\"rounded-2xl border border-slate-200 bg-white/70 p-6 shadow-glass\"><h3 class=\"text-lg font-bold text-ink\">Central Telemetry Bus</h3><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Every product streams structured events into one pipeline, powering Exora&#x27;s dashboards and student telemetry models in AarVed.</p></div><div class=\"rounded-2xl border border-slate-200 bg-white/70 p-6 shadow-glass\"><h3 class=\"text-lg font-bold text-ink\">Interactive Learning Pathways</h3><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">AarVed&#x27;s engine is embeddable, letting products expose educational modules and skill verification without rebuilding orchestration from scratch.</p></div></section><section class=\"mt-24\"><h2 class=\"text-2xl font-extrabold tracking-tight text-ink sm:text-3xl\">Engineering lifecycle</h2><p class=\"mt-2 max-w-2xl text-slate-600\">The path every feature takes, from a field report to a funder report.</p><ol class=\"mt-10 grid grid-cols-1 gap-5 md:grid-cols-3\"><li class=\"relative rounded-2xl border border-slate-200 bg-white/70 p-6 shadow-glass\"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800\">Discover</span><span class=\"font-mono text-xs text-slate-400\">01<!-- --> / <!-- -->06</span></div><h3 class=\"mt-4 text-lg font-bold text-ink\">Field-sourced problem discovery</h3><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Every AarGa product begins inside an active NGO deployment. Field teams log friction directly into the backlog, so engineering starts from a verified operational problem, not a hypothesis.</p><ul class=\"mt-4 flex flex-wrap gap-2\"><li class=\"rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500\">Field reports</li><li class=\"rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500\">Grassroots partner interviews</li><li class=\"rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500\">Operational telemetry</li></ul></li><li class=\"relative rounded-2xl border border-slate-200 bg-white/70 p-6 shadow-glass\"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800\">Design</span><span class=\"font-mono text-xs text-slate-400\">02<!-- --> / <!-- -->06</span></div><h3 class=\"mt-4 text-lg font-bold text-ink\">Dual-audience system design</h3><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Architecture is reviewed against two lenses simultaneously: enterprise SaaS scalability and low-connectivity, low-literacy field usability.</p><ul class=\"mt-4 flex flex-wrap gap-2\"><li class=\"rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500\">Offline-first constraints</li><li class=\"rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500\">Accessibility audits</li><li class=\"rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500\">Multi-tenant modeling</li></ul></li><li class=\"relative rounded-2xl border border-slate-200 bg-white/70 p-6 shadow-glass\"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800\">Build</span><span class=\"font-mono text-xs text-slate-400\">03<!-- --> / <!-- -->06</span></div><h3 class=\"mt-4 text-lg font-bold text-ink\">Shared platform primitives</h3><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">NexFix, Exora, and AarVed all consume the same identity, ledger, and telemetry primitives, so a fix in the core propagates across the ecosystem.</p><ul class=\"mt-4 flex flex-wrap gap-2\"><li class=\"rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500\">Shared auth core</li><li class=\"rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500\">Unified ledger service</li><li class=\"rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500\">Central telemetry bus</li></ul></li><li class=\"relative rounded-2xl border border-slate-200 bg-white/70 p-6 shadow-glass\"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800\">Verify</span><span class=\"font-mono text-xs text-slate-400\">04<!-- --> / <!-- -->06</span></div><h3 class=\"mt-4 text-lg font-bold text-ink\">Verified intern QA loops</h3><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Cohorts inside the Verified Interns Registry run structured QA and red-team passes on live features, generating the skill telemetry that also credentials them.</p><ul class=\"mt-4 flex flex-wrap gap-2\"><li class=\"rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500\">Structured QA cohorts</li><li class=\"rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500\">Red-team passes</li><li class=\"rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500\">Skill telemetry capture</li></ul></li><li class=\"relative rounded-2xl border border-slate-200 bg-white/70 p-6 shadow-glass\"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800\">Ship</span><span class=\"font-mono text-xs text-slate-400\">05<!-- --> / <!-- -->06</span></div><h3 class=\"mt-4 text-lg font-bold text-ink\">Progressive rollout</h3><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Releases move from a single NGO partner site, to a cluster of partner regions, to general availability across the commercial SaaS tier.</p><ul class=\"mt-4 flex flex-wrap gap-2\"><li class=\"rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500\">Canary partner sites</li><li class=\"rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500\">Regional clusters</li><li class=\"rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500\">GA rollout</li></ul></li><li class=\"relative rounded-2xl border border-slate-200 bg-white/70 p-6 shadow-glass\"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800\">Sustain</span><span class=\"font-mono text-xs text-slate-400\">06<!-- --> / <!-- -->06</span></div><h3 class=\"mt-4 text-lg font-bold text-ink\">Impact + uptime reporting</h3><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Exora unifies uptime, cost, and impact metrics into one reporting layer so funders and enterprise customers read from the same source of truth.</p><ul class=\"mt-4 flex flex-wrap gap-2\"><li class=\"rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500\">SLA dashboards</li><li class=\"rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500\">Funder impact reports</li><li class=\"rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500\">Cost-to-serve tracking</li></ul></li></ol></section><section class=\"mt-24\"><h2 class=\"text-2xl font-extrabold tracking-tight text-ink sm:text-3xl\">Product deep dive</h2><div class=\"mt-10 space-y-6\"><article id=\"nexfix\" class=\"scroll-mt-24 rounded-3xl border bg-white/70 p-8 shadow-glass border-moss-200\"><div class=\"flex flex-wrap items-center justify-between gap-3\"><div><span class=\"text-xs font-bold uppercase tracking-widest text-moss-700\">Operations &amp; Finance</span><h3 class=\"mt-1 text-2xl font-extrabold tracking-tight text-ink\">NexFix</h3></div><span class=\"rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-bold text-slate-500\">GA</span></div><p class=\"mt-4 max-w-3xl text-slate-600 leading-relaxed\">NexFix coordinates verified field technicians, parts inventory, maintenance accounting, and SLA tracking across distributed hardware deployments.</p><div class=\"mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 md:max-w-xl\"><div class=\"rounded-xl bg-slate-50 p-4 font-mono\"><div class=\"text-[10px] uppercase tracking-wide text-slate-400\">uptime</div><div class=\"mt-1 text-lg font-bold text-ink\">99.9%</div></div><div class=\"rounded-xl bg-slate-50 p-4 font-mono\"><div class=\"text-[10px] uppercase tracking-wide text-slate-400\">avg Resolve</div><div class=\"mt-1 text-lg font-bold text-ink\">6.2h</div></div><div class=\"rounded-xl bg-slate-50 p-4 font-mono\"><div class=\"text-[10px] uppercase tracking-wide text-slate-400\">techs Active</div><div class=\"mt-1 text-lg font-bold text-ink\">3,400+</div></div></div><div class=\"mt-6 flex flex-wrap gap-2\"><span class=\"rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-600\">Next.js</span><span class=\"rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-600\">Redis</span><span class=\"rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-600\">PostGIS</span><span class=\"rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-600\">Node.js</span></div></article><article id=\"exora\" class=\"scroll-mt-24 rounded-3xl border bg-white/70 p-8 shadow-glass border-emerald-200\"><div class=\"flex flex-wrap items-center justify-between gap-3\"><div><span class=\"text-xs font-bold uppercase tracking-widest text-emerald-700\">Secure Examinations &amp; Academic Integrity</span><h3 class=\"mt-1 text-2xl font-extrabold tracking-tight text-ink\">Exora</h3></div><span class=\"rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-bold text-slate-500\">GA</span></div><p class=\"mt-4 max-w-3xl text-slate-600 leading-relaxed\">Exora ingests raw operational telemetry and renders it as proctored assessment verification, funder-ready impact reports, and observability dashboards.</p><div class=\"mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 md:max-w-xl\"><div class=\"rounded-xl bg-slate-50 p-4 font-mono\"><div class=\"text-[10px] uppercase tracking-wide text-slate-400\">uptime</div><div class=\"mt-1 text-lg font-bold text-ink\">99.95%</div></div><div class=\"rounded-xl bg-slate-50 p-4 font-mono\"><div class=\"text-[10px] uppercase tracking-wide text-slate-400\">dashboards</div><div class=\"mt-1 text-lg font-bold text-ink\">2,100+</div></div><div class=\"rounded-xl bg-slate-50 p-4 font-mono\"><div class=\"text-[10px] uppercase tracking-wide text-slate-400\">data Points</div><div class=\"mt-1 text-lg font-bold text-ink\">48M/mo</div></div></div><div class=\"mt-6 flex flex-wrap gap-2\"><span class=\"rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-600\">ClickHouse</span><span class=\"rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-600\">dbt</span><span class=\"rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-600\">Next.js</span><span class=\"rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-600\">Python</span></div></article><article id=\"aarved\" class=\"scroll-mt-24 rounded-3xl border bg-white/70 p-8 shadow-glass border-gold-400/40\"><div class=\"flex flex-wrap items-center justify-between gap-3\"><div><span class=\"text-xs font-bold uppercase tracking-widest text-gold-600\">Education &amp; Student Learning</span><h3 class=\"mt-1 text-2xl font-extrabold tracking-tight text-ink\">AarVed</h3></div><span class=\"rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-bold text-slate-500\">Alpha</span></div><p class=\"mt-4 max-w-3xl text-slate-600 leading-relaxed\">AarVed provides interactive learning pathways, automated skill verification, and student telemetry for NGO education programs and vocational academies.</p><div class=\"mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 md:max-w-xl\"><div class=\"rounded-xl bg-slate-50 p-4 font-mono\"><div class=\"text-[10px] uppercase tracking-wide text-slate-400\">uptime</div><div class=\"mt-1 text-lg font-bold text-ink\">99.8%</div></div><div class=\"rounded-xl bg-slate-50 p-4 font-mono\"><div class=\"text-[10px] uppercase tracking-wide text-slate-400\">courses Live</div><div class=\"mt-1 text-lg font-bold text-ink\">42</div></div><div class=\"rounded-xl bg-slate-50 p-4 font-mono\"><div class=\"text-[10px] uppercase tracking-wide text-slate-400\">students Enrolled</div><div class=\"mt-1 text-lg font-bold text-ink\">1,200+</div></div></div><div class=\"mt-6 flex flex-wrap gap-2\"><span class=\"rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-600\">Next.js</span><span class=\"rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-600\">PostgreSQL</span><span class=\"rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-600\">Python</span><span class=\"rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-600\">Tailwind CSS</span></div></article></div></section></div><!--$--><!--/$--></div><footer class=\"border-t border-slate-200 bg-white/60\"><div class=\"mx-auto max-w-7xl px-6 py-14 lg:px-8\"><div class=\"grid gap-10 md:grid-cols-2 lg:grid-cols-5\"><div class=\"lg:col-span-2\"><div class=\"flex items-center gap-2.5\"><img alt=\"AarGa Logo\" width=\"120\" height=\"120\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain shrink-0 h-8 w-8\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Faarga-logo.png&amp;w=128&amp;q=75 1x, /_next/image?url=%2Faarga-logo.png&amp;w=256&amp;q=75 2x\" src=\"/_next/image?url=%2Faarga-logo.png&amp;w=256&amp;q=75\"/><span class=\"text-lg font-extrabold tracking-tight\">Aar<span class=\"text-emerald-600\">Ga</span></span></div><p class=\"mt-4 max-w-sm text-sm leading-relaxed text-slate-600\">One ecosystem, two missions: a grassroots NGO built to serve communities first, and a SaaS platform engineered to sustain that mission at scale.</p></div><div><h4 class=\"text-sm font-bold uppercase tracking-wide text-slate-500\">Ecosystem</h4><ul class=\"mt-4 space-y-3\"><li><a class=\"text-sm text-slate-600 transition-colors hover:text-emerald-700\" href=\"/ecosystem\">Overview</a></li><li><a class=\"text-sm text-slate-600 transition-colors hover:text-emerald-700\" href=\"/tech#nexfix\">NexFix</a></li><li><a class=\"text-sm text-slate-600 transition-colors hover:text-emerald-700\" href=\"/tech