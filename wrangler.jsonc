{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aarga",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aarga"
    }
  ],
  "routes": [
    {
      "pattern": "aarga.org/*",
      "zone_name": "aarga.org"
    },
    {
      "pattern": "portal.aarga.org/*",
      "zone_name": "aarga.org"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://qiocnszyjllorzyguzku.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_dp0LcR_MjE0_yzB4BYGUDg_8qqLwBVc"
  }
}
