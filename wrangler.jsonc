{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aarga",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aarga"
    }
  ],
  "routes": [
    {
      "pattern": "aarga.org",
      "custom_domain": true
    },
    {
      "pattern": "portal.aarga.org",
      "custom_domain": true
    }
  ]
}
