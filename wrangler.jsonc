{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aarga",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aarga"
    }
  ],
  "routes": [
    {
      "pattern": "aarga.org",
      "custom_domain": true
    },
    {
      "pattern": "portal.aarga.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://qiocnszyjllorzyguzku.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFpb2Nuc3p5amxsb3J6eWd1emt1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODczNTA3NTksImV4cCI6MjEwMjkyNjc1OX0.HVHKGjt5uXCfV6FBWe6HXgxbT0VBdRJKTBXtn4PJhyU"
  }
}
