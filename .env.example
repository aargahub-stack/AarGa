# Supabase project settings — copy this file to `.env.local` and fill in
# real values from your Supabase project (Project Settings -> API).
#
# NEXT_PUBLIC_SUPABASE_URL is safe to expose to the browser (it's just the
# project's REST endpoint). SUPABASE_SERVICE_ROLE_KEY is NOT — it bypasses
# Row Level Security and must only ever be read on the server. It is used
# exclusively inside src/lib/supabase/server.js, which is marked
# `import "server-only"` so Next.js will fail the build if it's ever
# accidentally imported into a client component.
#
# If these are left unset, every function in src/lib/api/* automatically
# falls back to the static seed data in src/data/*, so the site still runs
# locally with zero configuration.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
